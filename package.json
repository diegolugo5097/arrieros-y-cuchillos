{
  "name": "arrieros-y-cuchillos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arrieros y Cuchillos: Una Aventura Quindiana — juego de mesa digital",
  "scripts": {
    "dev": "concurrently -k -n web,servidor -c yellow,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "servidor": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "start": "tsx server/index.ts",
    "jugar": "npm run build && npm start",
    "preview": "vite preview",
    "simular": "tsx scripts/simular.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "concurrently": "^10.0.7",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
